{
	"type": "record",
	"name": "ParsedBookEvent",
	"namespace": "io.tibobit.orderbook",
	"doc": "Job 1's output on ex{exchange_id}-parsed-flink: a parsed book event still identified by the EXCHANGE'S OWN market string. pair_id is deliberately absent — resolving market to pair_id against exchange_markets is job 2's only responsibility. Every other field is identical to raw-order-book-event, which job 2 emits once it has the pair.",
	"fields": [
		{
			"name": "exchange_id",
			"type": "int",
			"doc": "Parsed by job 1 from the ex{id}-raw topic name — the payload itself does not say which exchange it came from. Job 2 reads it off the record rather than off the topic name."
		},
		{
			"name": "market",
			"type": "string",
			"doc": "The exchange's own market symbol, verbatim off the wire: \"btc_usdt\" for ex1, \"14\" for ex4, and so on — one per exchange's own convention, never normalized here. Job 2 resolves it against exchange_markets and drops the event if it is not there."
		},
		{
			"name": "type",
			"type": {
				"type": "enum",
				"name": "Type",
				"symbols": ["snapshot", "update"]
			},
			"doc": "No `reset` symbol, unlike raw-order-book-event: no parser ever emits one. `reset` is minted by job 3's TypeValidateFunction, four stages downstream of here."
		},
		{
			"name": "simulation",
			"type": "int",
			"default": 0,
			"doc": "Injected by NiFi on the raw payload: a root field for the object-root exchanges, a trailing {\"simulation\": N} element for ex3/wallex's array envelope. 0 = live data, 1 = simulation data; other values undefined. Carried unchanged through every job; absent = 0."
		},
		{
			"name": "id",
			"type": "string",
			"default": "",
			"doc": "UUID minted by whichever step WROTE this record to its topic — unique per emitted record, never reused. Job 1 mints it here on emit; job 2 mints a fresh one and names this id as its parent. The empty default only ever appears on records written before this field existed — a live producer always sets it."
		},
		{
			"name": "source_ids",
			"type": { "type": "array", "items": "string" },
			"default": [],
			"doc": "ids of the records read on THIS hop to produce this one: immediate parents only, never the accumulated chain. Here that is the single id NiFi minted onto the raw payload. Job 1 drops any payload whose id is missing, so this is never empty on this stream."
		},
		{
			"name": "sequence_id",
			"type": ["null", "long"],
			"default": null
		},
		{
			"name": "sequence_jump",
			"type": "long"
		},
		{
			"name": "event_time",
			"type": {
				"type": "long",
				"logicalType": "timestamp-millis"
			}
		},
		{
			"name": "exchange_event_time",
			"type": [
				"null",
				{
					"type": "long",
					"logicalType": "timestamp-millis"
				}
			],
			"default": null,
			"doc": "The exchange's OWN clock, straight off the wire, or null when the exchange does not send one. Unlike event_time it is never substituted: ex3/wallex and ex4/ramzinex carry no timestamp at all, and ex7/ompfinex sends one on snapshots but not on updates, so those are null here while event_time holds job 1's processing time. Null therefore means 'this feed cannot answer when it happened', which is the point — it is what makes an exchange-to-here lag measurement honest. Set once by job 1 and never rewritten."
		},
		{
			"name": "asks",
			"type": [
				"null",
				{
					"type": "array",
					"items": {
						"type": "record",
						"name": "PriceLevel",
						"fields": [
							{ "name": "price", "type": "string" },
							{ "name": "quantity", "type": "string" }
						]
					}
				}
			],
			"default": null
		},
		{
			"name": "bids",
			"type": ["null", { "type": "array", "items": "PriceLevel" }],
			"default": null
		},
		{
			"name": "pipeline_timings",
			"type": ["null", {
				"type": "record",
				"name": "PipelineTimings",
				"doc": "Per-step latency timings; each job fills its own two fields (null = not yet reached). Only parse_in/parse_out are ever set on this stream — the rest exist so the record is the same shape as the one raw-order-book-event carries. See memory/project_raw_pipeline_decision.md.",
				"fields": [
					{ "name": "parse_in", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null },
					{ "name": "parse_out", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null },
					{ "name": "pair_extract_in", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null },
					{ "name": "pair_extract_out", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null },
					{ "name": "type_validate_in", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null },
					{ "name": "type_validate_out", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null },
					{ "name": "rebase_in", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null },
					{ "name": "rebase_out", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null },
					{ "name": "precision_in", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null },
					{ "name": "precision_out", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null },
					{ "name": "book_build_in", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null },
					{ "name": "book_build_out", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null }				]
			}],
			"default": null
		}
	]
}
