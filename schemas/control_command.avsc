{
	"type": "record",
	"name": "ControlCommand",
	"namespace": "io.tibobit.normalizer.avro",
	"doc": "A control-plane command from job 2 back to the collector, on the shared `control-plane` topic. The only record that travels against the data flow: everything else moves NiFi -> jobs -> web, this moves job -> NiFi.",
	"fields": [
		{
			"name": "action",
			"type": "string",
			"doc": "What NiFi is being asked to do. Only `snapshot_request` exists today: re-send a full snapshot for this market, because job 2 can no longer trust the book it is building."
		},
		{
			"name": "reason",
			"type": "string",
			"default": "",
			"doc": "Why the snapshot is being asked for. Two reasons come from a REJECTED event: `no_baseline` (job 2 has never seen a snapshot for this market, so there is nothing to apply updates to) and `sequence_gap` (a hole in the sequence invalidated the book it had). Two come from the health TIMER and carry no `source_ids`, because no event caused them: `stale` means the market was sending and then stopped for longer than its `exchange_markets.staleness_threshold_seconds`, and `no_progress` (added 2026-09-07) means the opposite half of the same fault — frames keep ARRIVING and job 2 has accepted none of them for that whole threshold, which is what a sequence counter that re-based below the last accepted one looks like (ex2/ex4 Centrifugo `pub.offset` recreated, ex5 `seq` on a reconnect). A snapshot-only feed can reach neither of the two rejected-event reasons, so before `no_progress` existed such a key stayed dead-lettered until an operator restarted the job. In both cases the book downstream is frozen and has been emptied with a reset. There is deliberately no reason for a market that has NEVER sent anything: job 2 only watches markets it has heard from, and a never-wired-up subscription is an alerting matter for the staleness exporter, not something a snapshot can fix. Same vocabulary as `reject_reason` on the dead-letter topic, and the two are the only conditions that make a re-snapshot worth asking for — a duplicate or a late snapshot leaves the book intact. On a repeated request the reason is the one that OPENED the episode, not `awaiting_snapshot`: the retry asks for the same thing for the same cause."
		},
		{
			"name": "exchange_id",
			"type": "int",
			"doc": "The market to re-snapshot, together with pair_id. Also half of the Kafka key, `{exchange_id}|{pair_id}`."
		},
		{
			"name": "pair_id",
			"type": "int",
			"doc": "The market to re-snapshot, together with exchange_id."
		},
		{
			"name": "simulation",
			"type": "int",
			"default": 0,
			"doc": "Carried from the event whose gap triggered the request. 0 = live, 1 = simulation. A request raised by simulated data must not make NiFi call a real exchange."
		},
		{
			"name": "id",
			"type": "string",
			"default": "",
			"doc": "UUID minted for this command — a write to a topic, so it gets an id of its own like every other emitted record."
		},
		{
			"name": "source_ids",
			"type": { "type": "array", "items": "string" },
			"default": [],
			"doc": "The id of the event that triggered the request — the update that hit `no_baseline` or `sequence_gap`. Immediate parent only. That one event is simultaneously the parent of the dead-letter record and of the synthetic reset marker."
		}
	]
}
