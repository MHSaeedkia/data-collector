{
	"type": "record",
	"name": "RawOrderBookEvent",
	"namespace": "io.tibobit.orderbook",
	"fields": [
		{
			"name": "exchange_id",
			"type": "int"
		},
		{
			"name": "pair_id",
			"type": "int"
		},
		{
			"name": "type",
			"type": {
				"type": "enum",
				"name": "Type",
				"symbols": ["snapshot", "update", "reset"]
			}
		},
		{
			"name": "simulation",
			"type": "int",
			"default": 0,
			"doc": "Injected by NiFi on the raw payload: a root field for the object-root exchanges, a trailing {\"simulation\": N} element for ex3/wallex's array envelope. 0 = live data, 1 = simulation data; other values undefined. Carried unchanged through every job; absent = 0."
		},
		{
			"name": "sink_id",
			"type": "string",
			"default": "",
			"doc": "UUID minted by whichever step WROTE this record to its topic — unique per emitted record, never reused. NiFi mints the first one onto the raw payload (same carrier as simulation: a root field, or the trailing object for ex3/wallex); jobs 1-5 each mint a fresh one on emit. The empty default only ever appears on records written before this field existed — a live producer always sets it."
		},
		{
			"name": "source_ids",
			"type": { "type": "array", "items": "string" },
			"default": [],
			"doc": "sink_ids of the records read on THIS hop to produce this one: immediate parents only, never the accumulated chain. One element for the pass-through steps; job 1 drops any payload whose sink_id is missing, so this is never empty on the raw stream."
		},
		{
			"name": "sequence_id",
			"type": ["null", "long"],
			"default": null
		},
		{
			"name": "sequence_jump",
			"type": "long"
		},
		{
			"name": "event_time",
			"type": {
				"type": "long",
				"logicalType": "timestamp-millis"
			}
		},
		{
			"name": "asks",
			"type": [
				"null",
				{
					"type": "array",
					"items": {
						"type": "record",
						"name": "PriceLevel",
						"fields": [
							{ "name": "price", "type": "string" },
							{ "name": "quantity", "type": "string" }
						]
					}
				}
			],
			"default": null
		},
		{
			"name": "bids",
			"type": ["null", { "type": "array", "items": "PriceLevel" }],
			"default": null
		},
		{
			"name": "pipeline_timings",
			"type": ["null", {
				"type": "record",
				"name": "PipelineTimings",
				"doc": "Per-step latency timings; each job fills its own two fields (null = not yet reached). See memory/project_raw_pipeline_decision.md.",
				"fields": [
					{ "name": "pair_extract_in", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null },
					{ "name": "pair_extract_out", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null },
					{ "name": "type_validate_in", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null },
					{ "name": "type_validate_out", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null },
					{ "name": "rebase_in", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null },
					{ "name": "rebase_out", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null },
					{ "name": "precision_in", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null },
					{ "name": "precision_out", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null },
					{ "name": "book_build_in", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null },
					{ "name": "book_build_out", "type": ["null", { "type": "long", "logicalType": "timestamp-millis" }], "default": null }				]
			}],
			"default": null
		}
	]
}
