{
	"type": "record",
	"name": "AggregatedOrderBookEvent",
	"namespace": "io.tibobit.orderbook",
	"fields": [
		{
			"name": "pair_id",
			"type": "int"
		},
		{
			"name": "side",
			"type": {
				"type": "enum",
				"name": "Side",
				"symbols": ["asks", "bids"]
			}
		},
		{
			"name": "id",
			"type": "string",
			"default": "",
			"doc": "UUID minted by job 6 for this aggregated record. There is deliberately no record-level source_ids here: the union mixes exchanges, so the parent of a level is only meaningful per level — see source_id on AggregatedLevel."
		},
		{
			"name": "max_event_time",
			"type": {
				"type": "long",
				"logicalType": "timestamp-millis"
			},
			"doc": "Newest event_time across the exchange books in the union — the freshest news this record carries. Renamed from `event_time` on 2026-09-15: one number cannot describe a book built from several exchanges at several times, so the name now says WHICH of them it is. See min_event_time beside it."
		},
		{
			"name": "min_event_time",
			"type": [
				"null",
				{
					"type": "long",
					"logicalType": "timestamp-millis"
				}
			],
			"default": null,
			"doc": "Oldest event_time across the exchange books that actually CONTRIBUTED LEVELS to this record — the stalest data a consumer is being handed, which is what a staleness alarm wants. Books dropped to empty (job 2's reset, job 5's empty book) are excluded on purpose: they contribute no price, so their timestamp describes nothing in here. Null when no exchange contributed a level at all, i.e. the whole union is empty — that is the absence of data, not a time of zero."
		},
		{
			"name": "levels",
			"type": {
				"type": "array",
				"items": {
					"type": "record",
					"name": "AggregatedLevel",
					"fields": [
						{
							"name": "exchange_id",
							"type": "int"
						},
						{
							"name": "simulation",
							"type": "int",
							"default": 0,
							"doc": "The contributing exchange's simulation flag, per level: the union is across exchanges, so a level carries the flag of the book it came from. 0 = live, 1 = simulation."
						},
						{
							"name": "source_id",
							"type": "string",
							"default": "",
							"doc": "id of the job-5 snapshot this level came from — per level for the same reason exchange_id is: the union mixes exchanges, so one parent per record would be a lie. Singular, not an array: a level comes from exactly one snapshot."
						},
						{
							"name": "price",
							"type": "string"
						},
						{
							"name": "quantity",
							"type": "string"
						}
					]
				}
			}
		}
	]
}
