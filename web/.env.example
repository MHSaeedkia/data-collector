PORT=3000
KAFKA_BROKER=localhost:9092
DATABASE_URL=postgres://postgres:postgres@localhost:5432/markets

# What the three dropdowns open on. All optional.
#
# DEFAULT_PAIR is a market symbol as postgres spells it, base/quote
# (case-insensitive). Unset — or a symbol no market matches — means the
# page opens on the first market in the list.
DEFAULT_PAIR=BTC/USDT
# DEFAULT_EXCHANGE is an exchange name, or one of the two cross-exchange
# views: aggregated (the union) or merged (the summed book). Unset or
# unknown means aggregated.
DEFAULT_EXCHANGE=aggregated
# DEFAULT_LEVEL_LIMIT is how many levels per side to show. Must be one of
# 25, 50, 100 or 200 — anything else is rejected with a log line and 25 is
# used. The limit is applied on the server, before the book is sent, so
# the browser never receives the levels it is not showing.
DEFAULT_LEVEL_LIMIT=25
