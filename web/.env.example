PORT=3000
KAFKA_BROKER=localhost:9092
DATABASE_URL=postgres://postgres:postgres@localhost:5432/markets
# How many levels per side the UI opens on. Must be one of the depths the
# dropdown offers — 25, 50, 100 or 200 — or it is rejected with a log line
# and 25 is used. The limit is applied on the server, before the book is
# sent, so the browser never receives the levels it is not showing.
LEVEL_LIMIT=25
