# Settings for warmup. `make warmup` copies this to .env on the first run, so
# edit .env, not this file.
#
# A real environment variable beats the file, so a one-off run needs no edit:
#   RETENTION_INPUT_MS=600000 make warmup
#
# Every value below is also warmup's built-in default: with no .env at all it
# behaves exactly the same.

# --- Endpoints -------------------------------------------------------------
# Reached from the HOST, not from inside the containers: docker-compose.yml and
# docker-compose.prod.yml both publish 9092 and 5432.
KAFKA_BOOTSTRAP=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8082
DATABASE_URL=postgres://postgres:postgres@localhost:5432/markets?sslmode=disable

# Directory holding the *.avsc files, relative to this project. Every schema in
# it is registered, the subject being the file name with dashes:
# raw_order_book_event.avsc -> raw-order-book-event.
SCHEMA_DIR=../schemas

# --- Topic retention, in milliseconds --------------------------------------
# 1 hour everywhere. Change one and re-run: warmup rewrites retention.ms on the
# topics that already exist, it does not only set it at creation.
# ⚠ Lowering a retention deletes whatever is already older than the new limit.
#
# For reference: 1h = 3600000, 6h = 21600000, 1d = 86400000, 2d = 172800000

# ex{id}-raw — NiFi's verbatim exchange payloads.
RETENTION_RAW_MS=3600000

# ex{id}-p{id}-*-flink — the normalizer's intermediate stages.
RETENTION_INPUT_MS=3600000

# p{id}-{side}, -merged, -adjusted — the aggregated books.
RETENTION_OUTPUT_MS=3600000

# ex{id}-p{id}-rejected-flink — the dead-letter topics.
RETENTION_REJECTED_MS=3600000

# control-plane — job 2's snapshot requests to NiFi.
RETENTION_CONTROL_MS=3600000

# --- Topic shape -----------------------------------------------------------
# One partition per topic is the design decision, not a default to tune: one
# exchange per topic is what guarantees ordering without a key.
TOPIC_PARTITIONS=1
TOPIC_REPLICATION=1

# How many topics go into one create/alter/describe request. Lower it if the
# controller struggles; there is no reason to raise it.
TOPIC_BATCH_SIZE=500
