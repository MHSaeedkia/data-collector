# Builds the six normalizer job jars INSIDE a container.
#
# The e2e harness runs on CI machines that have no JDK and no Maven, so nothing
# about the build may depend on the host beyond Docker itself. The final stage
# carries only the jars: the harness copies them out and uploads them to the
# Flink cluster over REST.
#
# Not to be confused with ./Dockerfile, which builds the Flink *cluster* image
# (that one layers the Kafka connector, flink-avro and the Confluent registry
# client into /opt/flink/lib; the jobs need it to run).

FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /src

# Poms first, so the dependency download is its own layer and survives every
# source edit. go-offline is best-effort — it stumbles over reactor-internal
# dependencies — and the package step below is what actually has to succeed.
COPY pom.xml .
COPY common/pom.xml common/
COPY job-pair-extractor/pom.xml job-pair-extractor/
COPY job-type-validator/pom.xml job-type-validator/
COPY job-rebaser/pom.xml job-rebaser/
COPY job-precision/pom.xml job-precision/
COPY job-book-builder/pom.xml job-book-builder/
COPY job-aggregator/pom.xml job-aggregator/
#
# Retried in-layer: a dropped transfer leaves everything already downloaded in
# ~/.m2, so a second attempt resumes rather than restarting. Retrying the whole
# RUN would throw that away, because a failed layer is never cached.
RUN mvn -B -q dependency:go-offline -DskipTests \
    || mvn -B -q dependency:go-offline -DskipTests \
    || echo "go-offline incomplete; package will fetch the remainder"

COPY common common
COPY job-pair-extractor job-pair-extractor
COPY job-type-validator job-type-validator
COPY job-rebaser job-rebaser
COPY job-precision job-precision
COPY job-book-builder job-book-builder
COPY job-aggregator job-aggregator
# Same in-layer retry. The last attempt drops -q so a genuine build failure is
# readable in the build log instead of silent.
RUN mvn -B -q package -DskipTests \
    || mvn -B -q package -DskipTests \
    || mvn -B package -DskipTests

# Rename to <module>.jar so the harness can address them by module name: the
# shaded artifactId does not always match the module directory, and shade
# leaves an original-*.jar behind next to the real one.
RUN mkdir /jars && \
    for m in job-pair-extractor job-type-validator job-rebaser \
             job-precision job-book-builder job-aggregator; do \
        jar="$(find "$m/target" -maxdepth 1 -name '*-1.0-SNAPSHOT.jar' ! -name 'original-*' | head -1)"; \
        [ -n "$jar" ] || { echo "no shaded jar built for $m" >&2; exit 1; }; \
        cp "$jar" "/jars/$m.jar"; \
    done

# Nothing but the jars. The harness starts this, copies them out, throws it away.
FROM busybox:1.37
COPY --from=build /jars /jars
CMD ["sh", "-c", "echo jars-ready && sleep 3600"]
