# Host-side endpoints for the F5 launch configs in launch.json (the in-code defaults are the
# docker-internal names the cluster uses). Keep in step with the exports in flink/run-local.sh.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8082
POSTGRES_URL=jdbc:postgresql://localhost:5432/markets
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
