{
	// Flink jobs, debuggable with F5 — no cluster and no shell script involved. Each config runs the
	// job's main() in this JVM; getExecutionEnvironment() returns a LocalStreamEnvironment off-cluster
	// and starts an in-process MiniCluster, which is the same thing flink/run-local.sh does.
	//
	// Two things make it work, both outside this file:
	//   - flink-clients is `provided`, not `test` (flink/normalizer/pom.xml, flink/merger/pom.xml).
	//     The IDE gives a src/main class the RUNTIME classpath, which excludes test scope, and
	//     without flink-clients env.execute() fails with "No ExecutorFactory found".
	//   - .vscode/flink-local.env points the job at the host's published ports; the in-code
	//     fallbacks are docker-internal names (kafka:29092) that do not resolve from here.
	//
	// Same caveats as run-local.sh: cancel the cluster's copy first or both write the same topics,
	// sources start at latest(), and MiniCluster state is lost on stop.
	"version": "0.2.0",
	"configurations": [
		{
			"type": "java",
			"name": "flink: adjustment",
			"request": "launch",
			"mainClass": "io.tibobit.adjustment.AdjustmentJob",
			"projectName": "adjustment",
			"envFile": "${workspaceFolder}/.vscode/flink-local.env"
		},
		{
			"type": "java",
			"name": "flink: merger",
			"request": "launch",
			"mainClass": "io.tibobit.merger.MergerJob",
			"projectName": "merger",
			"envFile": "${workspaceFolder}/.vscode/flink-local.env"
		},
		{
			"type": "java",
			"name": "flink: job-pair-extractor",
			"request": "launch",
			"mainClass": "io.tibobit.normalizer.pairextract.PairExtractorJob",
			"projectName": "job-pair-extractor",
			"envFile": "${workspaceFolder}/.vscode/flink-local.env"
		},
		{
			"type": "java",
			"name": "flink: job-type-validator",
			"request": "launch",
			"mainClass": "io.tibobit.normalizer.typevalidate.TypeValidatorJob",
			"projectName": "job-type-validator",
			"envFile": "${workspaceFolder}/.vscode/flink-local.env"
		},
		{
			"type": "java",
			"name": "flink: job-rebaser",
			"request": "launch",
			"mainClass": "io.tibobit.normalizer.rebase.RebaserJob",
			"projectName": "job-rebaser",
			"envFile": "${workspaceFolder}/.vscode/flink-local.env"
		},
		{
			"type": "java",
			"name": "flink: job-precision",
			"request": "launch",
			"mainClass": "io.tibobit.normalizer.precision.PrecisionJob",
			"projectName": "job-precision",
			"envFile": "${workspaceFolder}/.vscode/flink-local.env"
		},
		{
			"type": "java",
			"name": "flink: job-book-builder",
			"request": "launch",
			"mainClass": "io.tibobit.normalizer.bookbuild.BookBuilderJob",
			"projectName": "job-book-builder",
			"envFile": "${workspaceFolder}/.vscode/flink-local.env"
		},
		{
			"type": "java",
			"name": "flink: job-aggregator",
			"request": "launch",
			"mainClass": "io.tibobit.normalizer.aggregate.AggregatorJob",
			"projectName": "job-aggregator",
			"envFile": "${workspaceFolder}/.vscode/flink-local.env"
		},
		{
			// Fallback only: attach to a job started with DEBUG=1 flink/run-local.sh <job>.
			// The F5 configs above need no script; this exists for debugging the script's own
			// classpath, which is resolved by Maven rather than by the IDE.
			"type": "java",
			"name": "flink: attach to run-local.sh",
			"request": "attach",
			"hostName": "localhost",
			"port": 5005
		},
		{
			"name": "e2e tests",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/e2e",
			"args": ["-provision-stack=true"],
			"cwd": "${workspaceFolder}/e2e"
		},
		{
			"name": "e2e http",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/e2e",
			"args": ["-serve=true", "-addr=:9595", "-provision-stack=false"],
			"cwd": "${workspaceFolder}/e2e"
		}
	]
}
