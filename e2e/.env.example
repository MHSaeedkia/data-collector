KAFKA_BROKER=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8082
FLINK_API=http://localhost:7070
SETTLE=8

# Run ONE case from scenario/scenarios.go instead of the whole list. Either the
# full name or its leading number: SCENARIO=62 or SCENARIO=62-ex5-stale-seq.
# Empty (the default) runs everything. Usually passed on the command line —
# `SCENARIO=62 go run . -provision-stack=false` — since a real env var wins
# over this file.
# SCENARIO=
