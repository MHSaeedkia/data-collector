PORT=3000
KAFKA_BROKER=localhost:9092
DATABASE_URL=postgres://postgres:postgres@localhost:5432/markets

# What the three dropdowns open on. All optional.
#
# DEFAULT_PAIR_ID is a markets.id. Unset (or an id no market has) means the
# page opens on the first market in the list. `SELECT m.id, b.name, q.name
# FROM markets m JOIN currencies b ON m.base_id=b.id JOIN currencies q ON
# m.quote_id=q.id ORDER BY m.id;` lists them.
DEFAULT_PAIR_ID=1
# DEFAULT_EXCHANGE_ID is an exchanges.id, or one of the two cross-exchange
# views: 0 = separated (every exchange's levels side by side), -1 = merged
# (equal prices summed). Unset or unknown means 0.
DEFAULT_EXCHANGE_ID=0
# DEFAULT_LEVEL_LIMIT is how many levels per side to show. Must be one of
# 25, 50, 100 or 200 — anything else is rejected with a log line and 25 is
# used. The limit is applied on the server, before the book is sent, so
# the browser never receives the levels it is not showing.
DEFAULT_LEVEL_LIMIT=25
