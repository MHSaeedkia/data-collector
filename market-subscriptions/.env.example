# market-subscriptions — every setting the service reads. Copy to .env and edit.
# Real environment variables always win over this file, so the same image works
# unchanged in docker-compose (which sets them directly).

# HTTP port the console listens on.
PORT=8090

# Postgres holding exchange_markets / exchanges. Inside docker-compose the host is
# `postgres`; from the host machine it is `localhost`.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/markets

# NiFi's two control-plane endpoints. BASE_URL + the paths below are what actually
# gets called — both are logged at startup so a typo here is visible immediately.
NIFI_BASE_URL=http://nifi:8081/control-plane
NIFI_SUBSCRIBE_PATH=/subscribe
NIFI_UNSUBSCRIBE_PATH=/unsubscribe

# Per-request timeout, and how hard to retry before giving up on one market.
# Matches what csv-bulk-sync/market-sync.sh has always done.
NIFI_TIMEOUT=10s
NIFI_MAX_RETRIES=3
NIFI_RETRY_DELAY=2s

# How often the browser re-polls the table. 0 disables auto-refresh.
UI_REFRESH_SECONDS=10
